{
  "name": "assignments-hub-frontend",
  "version": "0.1.0",
  "description": "Assignments Hub - CBC Kenya SaaS frontend (React + Vite + TypeScript, talks to the existing NestJS API)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prebuild": "node scripts/generate-revision.mjs",
    "test:revision": "node --test scripts/revision.test.mjs",
    "test:assignments": "node --test scripts/assignment-list.test.mjs scripts/assignment-catalogue.test.mjs",
    "test:skills": "node --test scripts/skill-progress.test.mjs scripts/skill-lessons.test.mjs",
    "check:firstaid-assets": "node scripts/check-firstaid-assets.mjs",
    "test:stem": "node --test scripts/stem-investigations.test.mjs scripts/titration.test.mjs",
    "test:curriculum": "node --test scripts/curriculum.test.mjs",
    "test:kjsea": "node --test scripts/kjsea.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "three": "^0.180.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
