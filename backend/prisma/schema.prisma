// Assignments Hub - CBC Kenya SaaS
// Multi-tenant schema. Every tenant-scoped table carries school_id and is
// filtered by TenantGuard in the API layer (see src/common/guards/tenant.guard.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum PresenceDeviceType {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentMethod {
  INTASEND
  PAYSTACK
  MPESA
  EQUITY_PAYBILL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AWAITING_VERIFICATION
  CONFIRMED
  FAILED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum SubscriptionInterval {
  MONTHLY
  ANNUAL
}

enum IndependentPaymentClaimStatus {
  AWAITING_VERIFICATION
  CONFIRMED
  REJECTED
}

enum AssignmentType {
  AUTO_MARKED
  TEACHER_MARKED
  PRACTICAL
}

enum AssignmentKind {
  STANDARD
  KCSE_PAPER
}

enum LabType {
  SIMULATION
  PRACTICAL
}

enum LabStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillEnrollmentStatus {
  REQUESTED
  AWAITING_PAYMENT
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum ResourceListingType {
  NOTES
  ESSAY
  REVISION_GUIDE
  STUDY_GUIDE
  TOOLKIT
}

enum ResourceFulfillment {
  DIGITAL_DOWNLOAD
  PHYSICAL_DELIVERY
}

enum ResourceListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourcePurchaseStatus {
  PENDING_PAYMENT
  AWAITING_VERIFICATION
  PAID
  REJECTED
  CANCELLED
  FULFILLED
}

enum AcademicResultBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  NUMERIC
  SHORT_ANSWER
  ESSAY
  FILE_UPLOAD
  MATCHING
  ORDERING
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

enum SmsType {
  ASSIGNMENT_COMPLETED
  NEW_ASSIGNMENT
  BROADCAST
}

enum SmsStatus {
  SENT
  FAILED
}

// AI Assignment Generator provider (see backend/src/ai). OpenAI is the only
// active provider going forward — DEEPSEEK/CLAUDE are kept in the enum
// (rather than removed) purely so historical AiUsageLog/AiGenerationJob rows
// written before the OpenAI migration keep a valid, readable provider value;
// no code path writes those two values anymore. See AiProviderRouterService.
enum AiProvider {
  DEEPSEEK
  CLAUDE
  OPENAI
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

enum AiFeature {
  ASSIGNMENT_DRAFT
  QUESTION_SET
  FEEDBACK_DRAFT
  GRADING_SUGGESTION
  LEARNING_RECOMMENDATION
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiExtractionStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AiArtifactType {
  ASSIGNMENT_DRAFT
  QUESTION_SET
  FEEDBACK_DRAFT
  GRADING_SUGGESTION
  LEARNING_RECOMMENDATION
}

enum AiArtifactStatus {
  GENERATED
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum AiReviewDecision {
  APPROVED
  REJECTED
  EDITED
  PUBLISHED
}

enum CslSubmissionStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
}

// Centralized Question Bank (see backend/src/question-bank). PLATFORM rows
// are curated by PLATFORM_ADMIN and are global/read-only to every activated
// school. SCHOOL is reserved for a possible future school-authored tier —
// nothing in this change writes SCHOOL rows yet, but the column exists so
// that tier doesn't require another migration later.
enum QuestionBankSource {
  PLATFORM
  SCHOOL
}

enum QuestionBankStatus {
  GENERATED
  APPROVED
  REJECTED
}

// Drives which per-student rate applies in the subscription pricing table
// (see backend/src/common/config/plans.ts) — Day School and Boarding School
// are priced differently at every tier. Self-declared by the school admin on
// their own school settings, defaulting to DAY.
enum SchoolType {
  DAY
  BOARDING
}

enum SchoolThemeTemplate {
  ACADEMIC_NAVY
  ROYAL_BLUE
  MODERN_TEAL
  EMERALD_EDUCATION
  MAROON_PROFESSIONAL
}

// How a student ended up with a given track selection — did they pick it
// themselves, or accept the recommendation engine's top suggestion.
enum SelectionSource {
  MANUAL
  RECOMMENDATION
}

// Broad, self-reported category used to route a student toward relevant
// institutions and support guidance. Deliberately not a clinical/diagnostic
// classification — see StudentSupportAssessment's doc comment.
enum DisabilityCategory {
  VISUAL_IMPAIRMENT
  HEARING_IMPAIRMENT
  PHYSICAL_DISABILITY
  INTELLECTUAL_DEVELOPMENTAL
  AUTISM_SPECTRUM
  MULTIPLE_DEAFBLIND
  OTHER_UNSURE
}

// Self-reported level of day-to-day support the student currently needs —
// used only to weight which institution TYPE (fully specialized vs.
// inclusive-mainstream-with-accommodations) is suggested first, never
// exposed as a label on the student.
enum SupportLevel {
  MILD_SOME_SUPPORT
  MODERATE_REGULAR_SUPPORT
  SIGNIFICANT_INTENSIVE_SUPPORT
}

// What kind of place SupportInstitution row is — controls how it's grouped
// and captioned in the results view.
enum InstitutionType {
  ASSESSMENT_CENTER
  SPECIAL_SCHOOL
  INCLUSIVE_MAINSTREAM
  VOCATIONAL_TRAINING
  SUPPORT_ORGANIZATION
}

model School {
  kjseaMockAttempts KjseaMockAttempt[]
  id                 Int                 @id @default(autoincrement())
  name               String
  code               String              @unique // short code students use to log in, e.g. "GHSCH"
  logoUrl            String? // NOT @map'd — matches the original unmapped "logoUrl" column from the initial migration.
  address            String?
  phone              String?
  contactEmail       String?             @map("contact_email")
  subscriptionStatus SubscriptionStatus  @default(TRIAL)
  type               SchoolType          @default(DAY) @map("school_type")
  themeTemplate      SchoolThemeTemplate @default(ACADEMIC_NAVY) @map("theme_template")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  users                     User[]
  assignments               Assignment[]
  subscriptions             Subscription[]
  auditLogs                 AuditLog[]
  labSessions               LabSession[]
  smsLogs                   SmsLog[]
  cslSubmissions            CslSubmission[]
  pathwaySelections         StudentPathwaySelection[]
  supportAssessments        StudentSupportAssessment[]
  aiUsageLogs               AiUsageLog[]
  invoices                  Invoice[]
  paymentTransactions       PaymentTransaction[]
  aiUsageLedgerEntries      AIUsageLedger[]
  mentorProfiles            MentorProfile[]
  mentorshipRequests        MentorshipRequest[]
  talentProfiles            StudentTalentProfile[]
  messages                  Message[]
  aiFeatureConfigs          AiFeatureConfig[]
  aiGenerationJobs          AiGenerationJob[]
  aiExtractedContents       AiExtractedContent[]
  aiContentArtifacts        AiContentArtifact[]
  aiReviewEvents            AiReviewEvent[]
  questionBankItems         QuestionBank[]
  questionBankAccess        SchoolQuestionBankAccess?
  questionBankUsages        QuestionBankUsage[]
  assignmentDeliveryConfigs AssignmentDeliveryConfig[]
  studentAssignmentVariants StudentAssignmentVariant[]
  resourceListings          ResourceListing[]
  resourcePurchases         ResourcePurchase[]
  academicResultBatches     AcademicResultBatch[]
  academicResults           StudentAcademicResult[]
  studentStudyPlans         StudentStudyPlan[]
  learningCoachPlans        LearningCoachPlan[]
  learningCoachSessions     LearningCoachSession[]
  learningCoachResponses    LearningCoachResponse[]
  presenceSessions          UserPresenceSession[]

  @@map("schools")
}

model User {
  kjseaMockAttempts KjseaMockAttempt[]
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  role Role

  // Staff credentials (Teacher / School Admin / Platform Admin)
  email        String?
  passwordHash String? @map("password_hash")

  // Student credentials
  admissionNumber String? @map("admission_number")
  // Student's grade/class (e.g. "Grade 7"), used to scope which assignments
  // they see. Not applicable to staff roles.
  grade           String?
  // Parent/guardian phone number in international format (e.g.
  // "+254712345678"), used by SmsService to notify the parent when this
  // student completes an assignment or a new one is posted. Student-only.
  parentPhone     String? @map("parent_phone")

  // Set only for an "independent" student — one enrolled directly by
  // PLATFORM_ADMIN under the system's dedicated "Independent Students"
  // school container rather than through a paying school (see
  // backend/src/independent-students). Regular school-affiliated students
  // never set this; their access is governed by their SCHOOL's
  // subscription instead. Extended forward each time a payment is
  // recorded (IndependentStudentInvoice); AuthService blocks STUDENT login
  // once this is in the past.
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")

  // A self-registered independent learner can try exactly one eligible
  // starter assignment before activation. This is server-enforced by
  // IndependentTrialGuard; paid access always resets it to false.
  isIndependentTrial Boolean @default(false) @map("is_independent_trial")

  // Teacher-only metadata (credential allocation): subject specialty and
  // the class they're assigned to. Not applicable to other roles.
  subject       String?
  assignedClass String? @map("assigned_class")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions                      Submission[]
  auditLogs                        AuditLog[]
  createdAssignments               Assignment[]                 @relation("AssignmentCreatedBy")
  labSessions                      LabSession[]
  createdLabs                      Lab[]                        @relation("LabCreatedBy")
  gradedSubmissions                Submission[]                 @relation("SubmissionGradedBy")
  sentSmsLogs                      SmsLog[]                     @relation("SmsSentBy")
  smsLogsAboutMe                   SmsLog[]                     @relation("SmsAboutStudent")
  createdCslActivities             CslActivity[]                @relation("CslActivityCreatedBy")
  cslSubmissions                   CslSubmission[]              @relation("CslSubmissionByStudent")
  reviewedCslSubmissions           CslSubmission[]              @relation("CslSubmissionReviewedBy")
  pathwaySelections                StudentPathwaySelection[]
  refreshTokens                    RefreshToken[]
  supportAssessments               StudentSupportAssessment[]
  aiUsageLogs                      AiUsageLog[]
  verifiedPayments                 PaymentTransaction[]         @relation("PaymentVerifiedBy")
  studentProfile                   StudentProfile?
  skillEnrollments                 SkillEnrollment[]            @relation("SkillEnrollmentStudent")
  skillPayments                    SkillPayment[]               @relation("SkillPaymentStudent")
  // Set only when role = TEACHER and they've opted into the mentor
  // directory (see MentorProfile's comment).
  mentorProfile                    MentorProfile?
  mentorshipRequestsMade           MentorshipRequest[]          @relation("MentorshipRequestStudent")
  mentorshipLogEntries             MentorshipLogEntry[]
  talentProfile                    StudentTalentProfile?
  // News/Messages: any STUDENT can message any TEACHER at their school and
  // vice versa — see MessagesService.assertCanMessage. Not applicable to
  // SCHOOL_ADMIN/PLATFORM_ADMIN, who instead get read-only oversight via
  // GET /messages/admin/* (no send/receive relation needed for them).
  sentMessages                     Message[]                    @relation("MessageSender")
  receivedMessages                 Message[]                    @relation("MessageRecipient")
  // Independent-student billing — see IndependentStudentInvoice's comment.
  independentInvoices              IndependentStudentInvoice[]  @relation("IndependentInvoiceStudent")
  recordedIndependentInvoices      IndependentStudentInvoice[]  @relation("IndependentInvoiceRecordedBy")
  independentPaymentClaims         IndependentPaymentClaim[]    @relation("IndependentPaymentClaimStudent")
  reviewedIndependentPaymentClaims IndependentPaymentClaim[]    @relation("IndependentPaymentClaimReviewedBy")
  independentPaystackPayments     IndependentPaystackPayment[] @relation("IndependentPaystackPaymentStudent")
  updatedAiFeatureConfigs          AiFeatureConfig[]            @relation("AiFeatureConfigUpdatedBy")
  requestedAiGenerationJobs        AiGenerationJob[]            @relation("AiGenerationRequestedBy")
  uploadedAiExtractedContents      AiExtractedContent[]         @relation("AiExtractedContentUploadedBy")
  reviewedAiArtifacts              AiContentArtifact[]          @relation("AiArtifactReviewedBy")
  aiReviewEvents                   AiReviewEvent[]              @relation("AiReviewEventReviewer")
  createdQuestionBankItems         QuestionBank[]               @relation("QuestionBankCreatedBy")
  createdQuestionBankSources       QuestionBankSourceDocument[] @relation("QuestionBankSourceCreatedBy")
  selectedQuestionBankUsages       QuestionBankUsage[]          @relation("QuestionBankUsageSelectedBy")
  reviewedQuestionBankItems        QuestionBank[]               @relation("QuestionBankReviewedBy")
  activatedSchoolQuestionBanks     SchoolQuestionBankAccess[]   @relation("SchoolQuestionBankActivatedBy")
  assignmentVariants               StudentAssignmentVariant[]   @relation("StudentAssignmentVariantStudent")
  resourceListings                 ResourceListing[]            @relation("ResourceSeller")
  resourcePurchases                ResourcePurchase[]           @relation("ResourceBuyer")
  reviewedResourcePurchases        ResourcePurchase[]           @relation("ResourcePurchaseReviewer")
  uploadedAcademicResultBatches    AcademicResultBatch[]        @relation("AcademicResultBatchUploadedBy")
  academicResults                  StudentAcademicResult[]      @relation("AcademicResultStudent")
  studyPlans                       StudentStudyPlan[]           @relation("StudentStudyPlanStudent")
  generatedStudyPlans              StudentStudyPlan[]           @relation("StudentStudyPlanGeneratedBy")
  learningCoachPlans               LearningCoachPlan[]          @relation("LearningCoachPlanStudent")
  learningCoachSessions            LearningCoachSession[]       @relation("LearningCoachSessionStudent")
  learningCoachResponses           LearningCoachResponse[]      @relation("LearningCoachResponseStudent")
  presenceSessions                 UserPresenceSession[]

  @@unique([schoolId, email])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@map("users")
}

model StudentProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  admissionNumber String? @map("admission_number")
  grade           String?
  className       String? @map("class_name")
  stream          String?
  pathway         String?
  parentName      String? @map("parent_name")
  parentPhone     String? @map("parent_phone")
  parentEmail     String? @map("parent_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([admissionNumber])
  @@index([grade])
  @@index([pathway])
  @@map("student_profiles")
}

model SkillCategory {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  description  String?
  icon         String?
  imageUrl     String?            @map("image_url")
  displayOrder Int                @default(0) @map("display_order")
  status       SkillContentStatus @default(DRAFT)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  courses      SkillCourse[]

  @@index([status, displayOrder])
  @@map("skill_categories")
}

model SkillProvider {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  description  String?
  logoUrl      String?            @map("logo_url")
  website      String?
  contactEmail String?            @map("contact_email")
  verified     Boolean            @default(false)
  status       SkillContentStatus @default(DRAFT)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  courses      SkillCourse[]

  @@index([status])
  @@map("skill_providers")
}

model SkillCourse {
  id                   Int                @id @default(autoincrement())
  categoryId           Int                @map("category_id")
  category             SkillCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerId           Int                @map("provider_id")
  provider             SkillProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  title                String
  shortDescription     String             @map("short_description")
  fullDescription      String             @map("full_description")
  durationWeeks        Int                @map("duration_weeks")
  level                SkillLevel
  costKES              Int                @map("cost_kes")
  certificateAvailable Boolean            @default(false) @map("certificate_available")
  thumbnailUrl         String?            @map("thumbnail_url")
  learningOutcomes     Json?              @map("learning_outcomes")
  courseStructure      Json?              @map("course_structure")
  status               SkillContentStatus @default(DRAFT)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  enrollments          SkillEnrollment[]
  payments             SkillPayment[]

  @@index([categoryId, status])
  @@index([providerId])
  @@index([status])
  @@map("skill_courses")
}

model SkillEnrollment {
  id             Int                   @id @default(autoincrement())
  studentId      Int                   @map("student_id")
  student        User                  @relation("SkillEnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  courseId       Int                   @map("course_id")
  course         SkillCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         SkillEnrollmentStatus @default(REQUESTED)
  paymentStatus  PaymentStatus         @default(PENDING) @map("payment_status")
  requestedAt    DateTime              @default(now()) @map("requested_at")
  approvedAt     DateTime?             @map("approved_at")
  completedAt    DateTime?             @map("completed_at")
  lessonProgress SkillLessonProgress[]

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([studentId, status])
  @@map("skill_enrollments")
}

model SkillLessonProgress {
  id           Int             @id @default(autoincrement())
  enrollmentId Int             @map("enrollment_id")
  enrollment   SkillEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonKey    String          @map("lesson_key")
  startedAt    DateTime        @default(now()) @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([enrollmentId, lessonKey])
  @@index([enrollmentId, completedAt])
  @@map("skill_lesson_progress")
}

model SkillPayment {
  id                   Int           @id @default(autoincrement())
  studentId            Int           @map("student_id")
  student              User          @relation("SkillPaymentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  courseId             Int           @map("course_id")
  course               SkillCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod @map("payment_method")
  amountKES            Int           @map("amount_kes")
  transactionReference String?       @map("transaction_reference")
  status               PaymentStatus @default(PENDING)
  createdAt            DateTime      @default(now()) @map("created_at")

  @@index([studentId, courseId])
  @@index([status])
  @@map("skill_payments")
}

model MnemonicCard {
  id           Int      @id @default(autoincrement())
  title        String
  subject      String
  topic        String
  grade        String?
  description  String?
  pdfUrl       String   @map("pdf_url")
  fileName     String   @map("file_name")
  fileSize     Int?     @map("file_size")
  isPublished  Boolean  @default(false) @map("is_published")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isPublished, grade])
  @@index([subject, topic])
  @@map("mnemonic_cards")
}

model ResourceListing {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sellerId Int    @map("seller_id")
  seller   User   @relation("ResourceSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  title          String
  description    String?
  type           ResourceListingType
  fulfillment    ResourceFulfillment
  status         ResourceListingStatus @default(DRAFT)
  subject        String?
  grade          String?
  priceKES       Int                   @map("price_kes")
  platformFeeBps Int                   @map("platform_fee_bps")
  assetKey       String?               @map("asset_key")
  fileName       String?               @map("file_name")
  fileSize       Int?                  @map("file_size")
  coverImageUrl  String?               @map("cover_image_url")
  stockQuantity  Int?                  @map("stock_quantity")
  publishedAt    DateTime?             @map("published_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  purchases ResourcePurchase[]

  @@index([status, type, subject, grade])
  @@index([schoolId, sellerId, status])
  @@map("resource_listings")
}

model ResourcePurchase {
  id         Int             @id @default(autoincrement())
  schoolId   Int             @map("school_id")
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resourceId Int             @map("resource_id")
  resource   ResourceListing @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  studentId  Int             @map("student_id")
  student    User            @relation("ResourceBuyer", fields: [studentId], references: [id], onDelete: Restrict)

  status           ResourcePurchaseStatus @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod?         @map("payment_method")
  paymentReference String?                @map("payment_reference")
  payerPhone       String?                @map("payer_phone")
  amountKES        Int                    @map("amount_kes")
  platformFeeKES   Int                    @map("platform_fee_kes")
  sellerShareKES   Int                    @map("seller_share_kes")
  deliveryDetails  Json?                  @map("delivery_details")
  reviewedById     Int?                   @map("reviewed_by_id")
  reviewedBy       User?                  @relation("ResourcePurchaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?              @map("reviewed_at")
  rejectionReason  String?                @map("rejection_reason")
  fulfilledAt      DateTime?              @map("fulfilled_at")
  lastDownloadedAt DateTime?              @map("last_downloaded_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([studentId, status, createdAt])
  @@index([resourceId, status])
  @@index([schoolId, status])
  @@index([paymentReference])
  @@map("resource_purchases")
}

model AcademicResultBatch {
  id           Int                       @id @default(autoincrement())
  schoolId     Int                       @map("school_id")
  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedById Int                       @map("uploaded_by_id")
  uploadedBy   User                      @relation("AcademicResultBatchUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  name         String
  academicYear Int                       @map("academic_year")
  term         String
  grade        String
  className    String?                   @map("class_name")
  stream       String?
  fileName     String                    @map("file_name")
  status       AcademicResultBatchStatus @default(PROCESSING)
  rowCount     Int                       @default(0) @map("row_count")
  errors       Json?
  createdAt    DateTime                  @default(now()) @map("created_at")
  completedAt  DateTime?                 @map("completed_at")

  results    StudentAcademicResult[]
  studyPlans StudentStudyPlan[]

  @@index([schoolId, academicYear, term, grade, stream])
  @@index([schoolId, status, createdAt])
  @@map("academic_result_batches")
}

model StudentAcademicResult {
  id         Int                 @id @default(autoincrement())
  schoolId   Int                 @map("school_id")
  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batchId    Int                 @map("batch_id")
  batch      AcademicResultBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId  Int                 @map("student_id")
  student    User                @relation("AcademicResultStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subject    String
  score      Float
  maxScore   Float               @map("max_score")
  percentage Float
  gradeLabel String?             @map("grade_label")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([batchId, studentId, subject])
  @@index([schoolId, studentId, subject, createdAt])
  @@index([schoolId, subject, percentage])
  @@map("student_academic_results")
}

model StudentStudyPlan {
  id                   Int                  @id @default(autoincrement())
  schoolId             Int                  @map("school_id")
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId            Int                  @map("student_id")
  student              User                 @relation("StudentStudyPlanStudent", fields: [studentId], references: [id], onDelete: Cascade)
  generatedFromBatchId Int?                 @map("generated_from_batch_id")
  generatedFromBatch   AcademicResultBatch? @relation(fields: [generatedFromBatchId], references: [id], onDelete: SetNull)
  generatedById        Int?                 @map("generated_by_id")
  generatedBy          User?                @relation("StudentStudyPlanGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  periodKey            String               @map("period_key")
  weakSubjects         Json                 @map("weak_subjects")
  timetable            Json
  recommendations      Json
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@unique([studentId, periodKey])
  @@index([schoolId, periodKey])
  @@map("student_study_plans")
}

