// STEM Labs foundation (per backend/modules/stem_labs.md)
model LabSession {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId Int  @map("student_id")
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  labKey      String    @map("lab_key") // identifies the simulation/experiment
  competency  String? // CBC competency mapping
  completedAt DateTime? @map("completed_at")

  // Post-simulation knowledge-check quiz results (see LabQuestion). Both
  // null if the lab had no quiz questions at the time it was completed, or
  // the student hasn't taken the quiz yet — see LabSessionsService.create.
  // Reflected on the student's report card (ReportsService.studentReportCard).
  score             Int?
  maxScore          Int?      @map("max_score")
  // JSON array of { questionId, answer, isCorrect, pointsAwarded } — kept as
  // JSON rather than a relational table since lab quizzes are short and
  // never teacher-graded, unlike assignment submissions.
  answers           Json?
  quizCompletedAt   DateTime? @map("quiz_completed_at")
  reflectionAnswers Json?     @map("reflection_answers")
  stepProgress      Json?     @map("step_progress")
  completionSummary Json?     @map("completion_summary")
  timeSpentSeconds  Int?      @map("time_spent_seconds")

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@map("lab_sessions")
}

// Platform-wide catalog of virtual labs / practicals, managed by
// PLATFORM_ADMIN. `key` is what LabSession.labKey refers to when a student
// completes one (loose reference, not a DB foreign key, so existing
// LabSession rows referencing a key that predates the catalog still work).
model Lab {
  id              Int           @id @default(autoincrement())
  key             String        @unique
  title           String
  categoryId      Int?          @map("category_id")
  category        StemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stemSubjectId   Int?          @map("stem_subject_id")
  stemSubject     StemSubject?  @relation(fields: [stemSubjectId], references: [id], onDelete: SetNull)
  subject         String
  // Student's grade/class level this lab targets (e.g. "Grade 7"), matching
  // User.grade / Assignment.grade — students only see labs for their own
  // grade (see LabsService.findAll), same rule as assignments.
  grade           String
  // Narrower classification within `subject`, e.g. "Cell Biology" under
  // subject "Biology" — used for catalog filtering/grouping in the UI.
  topicArea       String?       @map("topic_area")
  // Senior School pathway grouping (e.g. "Pure Sciences", "Applied Sciences
  // - Agriculture", "Technical Studies"). Null for Junior School labs, which
  // aren't organized by pathway.
  pathway         String?
  topic           String?
  competency      String?
  // Human-readable description of the lab shown in the catalog (what the
  // student will watch/do).
  description     String?
  // Expected video length in minutes. Drives the frontend's watch-timer:
  // the "Continue to Quiz" button stays disabled for roughly this long
  // after the video starts, so a student can't skip straight to the quiz
  // without at least watching through (see frontend/stem-labs/index.html).
  durationMinutes Int?          @map("duration_minutes")
  type            LabType       @default(SIMULATION)
  status          LabStatus     @default(PUBLISHED)
  // A YouTube video URL (embed or watch link — the frontend normalizes it)
  // the student watches before taking the quiz. Null for labs that haven't
  // had real content added yet.
  resourceUrl     String?       @map("resource_url")
  introVideoUrl   String?       @map("intro_video_url")
  animationUrl    String?       @map("animation_url")
  voiceAudioUrl   String?       @map("voice_audio_url")
  isPublished     Boolean       @default(true) @map("is_published")

  // Ordered list of narration lines the frontend's female text-to-speech
  // voice-over reads aloud: an intro before the video plays, and an outro
  // once the quiz is submitted. Null/empty for labs without bespoke
  // narration yet — the frontend falls back to a generic line built from
  // `title`/`description`.
  guidanceSteps Json? @map("guidance_steps")

  // BECF (Kenyan CBC Basic Education Curriculum Framework) alignment
  // metadata. All additive/optional — a lab authored before these existed
  // simply has empty arrays / null values here, and every list below
  // degrades gracefully in the UI when empty.
  learningOutcomes   String[] @default([]) @map("learning_outcomes")
  coreCompetencies   String[] @default([]) @map("core_competencies")
  materials          String[] @default([])
  safetyChecklist    String[] @default([]) @map("safety_checklist")
  assessmentCriteria String[] @default([]) @map("assessment_criteria")
  // Pertinent and Contemporary Issues (PCIs) this lab touches on, e.g.
  // "Environmental Education", "Disaster Risk Reduction".
  pertinentIssues    String[] @default([]) @map("pertinent_issues")
  // Optional simplified/advanced variants of the lab content for
  // differentiated instruction. When present, the student player shows the
  // variant matching the student's grade tier (Grade 7-9 -> juniorVersion,
  // Grade 10-12 -> seniorVersion) alongside the main `description`.
  juniorVersion      String?  @map("junior_version")
  seniorVersion      String?  @map("senior_version")
  // Guidance for adapting this lab for learners with special needs —
  // authoring/teacher-facing; not surfaced directly to students.
  adaptationNotes    String?  @map("adaptation_notes")
  // What the student should capture as evidence for their portfolio.
  portfolioPrompt    String?  @map("portfolio_prompt")
  // How this lab connects to a real community issue/project.
  communityLink      String?  @map("community_link")
  // An activity a parent/guardian can do at home with the student.
  parentActivity     String?  @map("parent_activity")

  createdById Int?  @map("created_by_id")
  createdBy   User? @relation("LabCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions                LabQuestion[]
  media                    LabMedia[]
  steps                    LabStep[]
  reflectionPrompts        LabReflectionPrompt[]
  completionReportTemplate LabCompletionReportTemplate?

  @@index([categoryId])
  @@index([stemSubjectId])
  @@index([grade])
  @@map("labs")
}

model StemCategory {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects StemSubject[]
  labs     Lab[]

  @@map("stem_categories")
}

model StemSubject {
  id          Int          @id @default(autoincrement())
  categoryId  Int          @map("category_id")
  category    StemCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key         String       @unique
  name        String       @unique
  description String?
  order       Int          @default(0)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  labs Lab[]

  @@index([categoryId])
  @@map("stem_subjects")
}

model LabMedia {
  id        Int      @id @default(autoincrement())
  labId     Int      @map("lab_id")
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  caption   String?
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@map("lab_media")
}

model LabStep {
  id              Int      @id @default(autoincrement())
  labId           Int      @map("lab_id")
  lab             Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  title           String
  instruction     String
  mediaUrl        String?  @map("media_url")
  interactionType String?  @map("interaction_type")
  expectedOutcome String?  @map("expected_outcome")
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([labId])
  @@map("lab_steps")
}

model LabReflectionPrompt {
  id        Int      @id @default(autoincrement())
  labId     Int      @map("lab_id")
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  prompt    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@map("lab_reflection_prompts")
}

model LabCompletionReportTemplate {
  id           Int      @id @default(autoincrement())
  labId        Int      @unique @map("lab_id")
  lab          Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  title        String?
  summary      String?
  outcomesJson Json?    @map("outcomes_json")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("lab_completion_report_templates")
}

// Knowledge/competency check shown after a student finishes a lab's
// simulation. Deliberately mirrors Assignment's Question model (same
// QuestionType enum, same auto-grading rule: MULTIPLE_CHOICE/TRUE_FALSE/
// FILL_BLANK are scored server-side against `correctAnswer`; other types
// are left ungraded for now since there's no teacher-marking flow for lab
// quizzes yet).
model LabQuestion {
  id    Int @id @default(autoincrement())
  labId Int @map("lab_id")
  lab   Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  questionText  String       @map("question_text")
  questionType  QuestionType @default(MULTIPLE_CHOICE) @map("question_type")
  options       Json?
  // Never returned to students — see LabsService.stripAnswersForStudent.
  correctAnswer String?      @map("correct_answer")
  points        Int          @default(10)
  order         Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@map("lab_questions")
}

// Community Service Learning (CSL) — platform-wide catalog of grade-scoped
// activities, managed by PLATFORM_ADMIN (mirrors the Lab catalog pattern).
// `isRequired` activities are the ones a student's report card flags as
// outstanding until an APPROVED submission exists — see
// ReportsService.studentReportCard.
model CslActivity {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  title       String
  description String?
  // Student grade/class this activity targets, e.g. "Grade 7" — same
  // grade-scoping rule as Lab.grade.
  grade       String
  competency  String?
  isRequired  Boolean @default(true) @map("is_required")
  targetHours Int?    @map("target_hours")
  isPublished Boolean @default(true) @map("is_published")

  createdById Int?  @map("created_by_id")
  createdBy   User? @relation("CslActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions CslSubmission[]

  @@index([grade])
  @@map("csl_activities")
}

// A student's evidence (photo/video/document URL from POST
// /uploads/single) + reflection for one CslActivity, reviewed and scored by
// a teacher/school admin/platform admin ("tutor"). One row per
// (activity, student) — resubmitting after NEEDS_REVISION updates this same
// row rather than creating a new one (see CslSubmissionsService.create).
model CslSubmission {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  cslActivityId Int         @map("csl_activity_id")
  cslActivity   CslActivity @relation(fields: [cslActivityId], references: [id], onDelete: Cascade)

  studentId Int  @map("student_id")
  student   User @relation("CslSubmissionByStudent", fields: [studentId], references: [id], onDelete: Cascade)

  evidenceUrl String? @map("evidence_url")
  reflection  String?

  status   CslSubmissionStatus @default(PENDING)
  score    Int?
  maxScore Int?                @map("max_score")
  feedback String?

  reviewedById Int?      @map("reviewed_by_id")
  reviewedBy   User?     @relation("CslSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cslActivityId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("csl_submissions")
}

// Security_Model.md: audit logging of sensitive actions
model AuditLog {
  id       Int     @id @default(autoincrement())
  schoolId Int?    @map("school_id")
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String // e.g. "auth.login", "user.create", "assignment.update"
  resource  String? // e.g. "User:42"
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@map("audit_logs")
}

// Privacy-safe authenticated presence. A session records only the current
// route and broad device category; it never stores page content or answers.
model UserPresenceSession {
  id        Int    @id @default(autoincrement())
  sessionId String @unique @map("session_id")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  role        Role
  deviceType  PresenceDeviceType @default(UNKNOWN) @map("device_type")
  currentPath String             @map("current_path")

  startedAt  DateTime  @default(now()) @map("started_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  endedAt    DateTime? @map("ended_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([lastSeenAt])
  @@index([schoolId, lastSeenAt])
  @@index([role, lastSeenAt])
  @@index([userId, lastSeenAt])
  @@map("user_presence_sessions")
}

// SMS notifications: automatic (assignment completed / new assignment
// posted) and manual/mass (school admin or teacher broadcasts). One row per
// recipient phone number so a broadcast to 200 parents produces 200 rows
// with individually tracked delivery status — useful for retry/audit.
model SmsLog {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  type         SmsType
  toPhone      String    @map("to_phone")
  message      String
  status       SmsStatus @default(SENT)
  errorMessage String?   @map("error_message")

  // Optional linkage — set for ASSIGNMENT_COMPLETED / NEW_ASSIGNMENT so a
  // sent message can be traced back to the student/assignment involved.
  // No FK to Assignment (assignments are freely deletable; keeping the log
  // row around after that shouldn't require a schema-level cascade rule).
  studentId    Int?  @map("student_id")
  student      User? @relation("SmsAboutStudent", fields: [studentId], references: [id], onDelete: SetNull)
  assignmentId Int?  @map("assignment_id")

  sentById Int?  @map("sent_by_id")
  sentBy   User? @relation("SmsSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@map("sms_logs")
}

// AI Assignment Generator usage tracking (see backend/src/ai,
// AiProviderRouterService): one row per provider attempt, success or
// failure, across DeepSeek and Claude. Foundation for a future school-level
// AI generation limit, per-provider usage reports, token/cost tracking, and
// admin analytics — none of those are implemented yet, this model only
// records the data they'll need.
model AiUsageLog {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Nullable + SetNull (like AuditLog.userId) so the usage row — and any
  // future billing/report built on it — survives the user being removed.
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  provider         AiProvider
  // Provider's model identifier, e.g. "deepseek-chat" or a dated Claude
  // snapshot. Nullable — not always known on a failed attempt.
  model            String?
  status           AiUsageStatus
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  totalTokens      Int?          @map("total_tokens")
  errorMessage     String?       @map("error_message")
  createdAt        DateTime      @default(now())

  @@index([schoolId])
  @@index([userId])
  @@map("ai_usage_logs")
}

model AiFeatureConfig {
  id                  Int       @id @default(autoincrement())
  schoolId            Int       @map("school_id")
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feature             AiFeature
  enabled             Boolean   @default(false)
  previewOnly         Boolean   @default(true) @map("preview_only")
  monthlyRequestLimit Int?      @map("monthly_request_limit")
  configuration       Json?
  updatedById         Int?      @map("updated_by_id")
  updatedBy           User?     @relation("AiFeatureConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, feature])
  @@index([schoolId, enabled])
  @@map("ai_feature_configs")
}

model AiGenerationJob {
  id                    Int                 @id @default(autoincrement())
  schoolId              Int                 @map("school_id")
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedById         Int                 @map("requested_by_id")
  requestedBy           User                @relation("AiGenerationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  feature               AiFeature
  status                AiJobStatus         @default(QUEUED)
  extractedContentId    Int?                @map("extracted_content_id")
  extractedContent      AiExtractedContent? @relation(fields: [extractedContentId], references: [id], onDelete: SetNull)
  sourceAssignmentId    Int?                @map("source_assignment_id")
  sourceAssignment      Assignment?         @relation("AiSourceAssignment", fields: [sourceAssignmentId], references: [id], onDelete: SetNull)
  sourceSubmissionId    Int?                @map("source_submission_id")
  sourceSubmission      Submission?         @relation("AiSourceSubmission", fields: [sourceSubmissionId], references: [id], onDelete: SetNull)
  provider              AiProvider?
  model                 String?
  promptTemplateVersion String              @map("prompt_template_version")
  idempotencyKey        String              @map("idempotency_key")
  inputHash             String              @map("input_hash")
  parameters            Json?
  promptTokens          Int?                @map("prompt_tokens")
  completionTokens      Int?                @map("completion_tokens")
  totalTokens           Int?                @map("total_tokens")
  errorCode             String?             @map("error_code")
  errorMessage          String?             @map("error_message")
  startedAt             DateTime?           @map("started_at")
  completedAt           DateTime?           @map("completed_at")
  expiresAt             DateTime?           @map("expires_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  artifacts             AiContentArtifact[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, feature, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([extractedContentId])
  @@index([sourceAssignmentId])
  @@index([sourceSubmissionId])
  @@map("ai_generation_jobs")
}

model AiExtractedContent {
  id             Int                 @id @default(autoincrement())
  schoolId       Int                 @map("school_id")
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedById   Int                 @map("uploaded_by_id")
  uploadedBy     User                @relation("AiExtractedContentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName       String              @map("file_name")
  fileUrl        String?             @map("file_url")
  storageKey     String?             @map("storage_key")
  subject        String
  grade          String?
  topicCount     Int                 @default(0) @map("topic_count")
  content        Json
  status         AiExtractionStatus  @default(PROCESSING)
  error          String?
  idempotencyKey String              @map("idempotency_key")
  inputHash      String              @map("input_hash")
  startedAt      DateTime?           @map("started_at")
  processedAt    DateTime?           @map("processed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  jobs           AiGenerationJob[]
  artifacts      AiContentArtifact[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, status, createdAt])
  @@index([uploadedById, createdAt])
  @@map("ai_extracted_contents")
}

model AiContentArtifact {
  id                    Int                 @id @default(autoincrement())
  schoolId              Int                 @map("school_id")
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  generationJobId       Int                 @map("generation_job_id")
  generationJob         AiGenerationJob     @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  extractedContentId    Int?                @map("extracted_content_id")
  extractedContent      AiExtractedContent? @relation(fields: [extractedContentId], references: [id], onDelete: SetNull)
  type                  AiArtifactType
  status                AiArtifactStatus    @default(GENERATED)
  version               Int                 @default(1)
  content               Json
  contentHash           String              @map("content_hash")
  publishedAssignmentId Int?                @map("published_assignment_id")
  publishedAssignment   Assignment?         @relation("AiPublishedAssignment", fields: [publishedAssignmentId], references: [id], onDelete: SetNull)
  reviewedById          Int?                @map("reviewed_by_id")
  reviewedBy            User?               @relation("AiArtifactReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?           @map("reviewed_at")
  publishedAt           DateTime?           @map("published_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  reviews               AiReviewEvent[]

  @@index([schoolId, type, status, createdAt])
  @@index([generationJobId])
  @@index([extractedContentId])
  @@index([publishedAssignmentId])
  @@map("ai_content_artifacts")
}

model AiReviewEvent {
  id          Int               @id @default(autoincrement())
  schoolId    Int               @map("school_id")
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  artifactId  Int               @map("artifact_id")
  artifact    AiContentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  reviewerId  Int               @map("reviewer_id")
  reviewer    User              @relation("AiReviewEventReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision    AiReviewDecision
  notes       String?
  contentHash String?           @map("content_hash")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([artifactId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("ai_review_events")
}

// ============================================================================
// Career Pathway Assessment (KICD Senior School Pathways, Grades 10-12)
// ----------------------------------------------------------------------------
// Pathway (STEM / Arts & Sports / Social Sciences) and Track (e.g. "Pure
// Sciences" under STEM) are a platform-wide catalog, managed by
// PLATFORM_ADMIN — mirrors the Lab/CslActivity catalog pattern elsewhere in
// this schema: global, not school-scoped, seeded once and rarely edited.
// StudentPathwaySelection is the per-student, per-school record, mirroring
// CslSubmission.
// ============================================================================

// One of the 3 KICD Senior School pathways.
model Pathway {
  id          Int    @id @default(autoincrement())
  key         String @unique // "stem" | "arts" | "social"
  name        String
  description String
  icon        String // Font Awesome class, e.g. "fa-flask"
  colorHex    String @default("#BBD125") @map("color_hex")
  order       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks Track[]

  @@map("pathways")
}

// One specialization within a Pathway (e.g. "Pure Sciences", "Fine Arts",
// "Business Studies"). Everything a student needs to evaluate this track —
// required subjects, careers, universities, skills — is stored as JSON here,
// the same way Assignment.attachments/Question.options are elsewhere in this
// schema: it's reference content read as a whole and never filtered by its
// individual sub-fields, so typed JSON columns are simpler and far faster to
// extend (add a career, add a university) than a web of junction tables.
// Shapes (all populated by prisma/seed-pathways-data.ts):
//   requiredSubjects:  [{ subject: string, minGrade: string }]
//   careers:           [{ title, description?, salaryMinKES, salaryMaxKES }]
//   skills:            string[]
//   universitiesKenya: [{ name, programs: string[] }]
//   universitiesIntl:  [{ name, country, programs: string[] }]
//   nextSteps / extracurriculars / certifications / workExperience: string[]
model Track {
  id        Int     @id @default(autoincrement())
  pathwayId Int     @map("pathway_id")
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  key         String // "pure-sciences" — unique within its pathway
  name        String
  description String
  icon        String
  order       Int    @default(0)

  requiredSubjects Json    @map("required_subjects")
  // Overall KCSE mean grade requirement, e.g. "B+". Nullable — some tracks
  // (e.g. Sports) are less strictly grade-gated than the pure sciences.
  minMeanGrade     String? @map("min_mean_grade")

  careers       Json
  skills        Json
  jobOutlook    String? @map("job_outlook")
  jobGrowthRate String? @map("job_growth_rate")

  universitiesKenya   Json @map("universities_kenya")
  universitiesIntl    Json @map("universities_intl")
  degreeDurationYears Int? @default(4) @map("degree_duration_years")

  // string[] of interest keywords (e.g. "science", "art", "sports") used
  // purely by PathwaysService's recommendation engine to score a student's
  // self-reported interests against each track — see
  // seed-pathways-data.ts for the fixed vocabulary.
  interestTags Json? @map("interest_tags")

  nextSteps        Json? @map("next_steps")
  extracurriculars Json?
  certifications   Json?
  workExperience   Json? @map("work_experience")

  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  selections StudentPathwaySelection[]

  @@unique([pathwayId, key])
  @@index([pathwayId])
  @@map("tracks")
}

// A student's track selection. History-preserving: choosing a different
// track inserts a NEW row (with isActive = true) and flips the student's
// previous row to isActive = false, rather than overwriting it in place —
// see PathwaysService.selectTrack. The row with isActive = true (at most one
// per student, enforced in the service layer via a transaction) is the
// student's current selection; every row together is their full history,
// satisfying "track their pathway selection history" without a separate
// audit table.
model StudentPathwaySelection {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId Int  @map("student_id")
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  trackId Int   @map("track_id")
  track   Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  isActive Boolean         @default(true) @map("is_active")
  // Optional student-written reasoning ("why I chose this track"), shown to
  // teachers/parents on the report and editable any time.
  notes    String?
  source   SelectionSource @default(MANUAL)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([trackId])
  @@map("student_pathway_selections")
}

// Platform-wide catalog of real Kenyan institutions/organizations relevant
// to a student with a disability or additional support need: EARC
// assessment centres, special schools, inclusive mainstream schools known
// for good accommodations, vocational training providers, and ongoing
// support organizations (e.g. KISE, APDK). Mirrors the Pathway/Track
// pattern — global, PLATFORM_ADMIN-managed, seeded from a curated data
// file rather than relational per-field tables, since this is reference
// content that's always read as a whole.
model SupportInstitution {
  id              Int             @id @default(autoincrement())
  key             String          @unique
  name            String
  type            InstitutionType
  // A given institution can serve more than one category (e.g. a school for
  // "physical and multiple disabilities") — stored as a JSON string array
  // of DisabilityCategory values rather than a native Postgres enum array,
  // consistent with the Json-columns-for-catalog-data convention already
  // used by Track's careers/universitiesKenya/etc.
  categories      Json
  county          String
  town            String?
  boardingType    String?         @map("boarding_type") // "Day" | "Boarding" | "Day & Boarding"
  ageRange        String?         @map("age_range")
  description     String
  servicesOffered Json?           @map("services_offered")
  contactPhone    String?         @map("contact_phone")
  contactEmail    String?         @map("contact_email")
  website         String?
  sourceNote      String?         @map("source_note") // brief attribution/last-verified note shown on the results view
  order           Int             @default(0)
  isPublished     Boolean         @default(true) @map("is_published")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
  @@map("support_institutions")
}

// A student's (or, realistically, a parent/guardian acting through the
// student account's) self-reported intake for support-needs guidance.
// Deliberately NOT a diagnosis or a replacement for a real assessment —
// this exists to (a) point every family toward their local Educational
// Assessment and Resource Centre (EARC) if they haven't already been
// assessed, and (b) surface a relevant, real starting shortlist of
// institutions and next steps in the meantime. History-preserving via
// isActive, same pattern as StudentPathwaySelection: a follow-up intake
// inserts a new row and flips the previous one's isActive to false rather
// than overwriting it, so a teacher/parent can see how things evolved.
model StudentSupportAssessment {
  id        Int    @id @default(autoincrement())
  schoolId  Int    @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId Int    @map("student_id")
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  category            DisabilityCategory
  supportLevel        SupportLevel       @map("support_level")
  // Has the student/family already been through a formal EARC functional
  // assessment? Drives whether the results view leads with "go get
  // assessed first" or with the institution shortlist.
  hasFormalAssessment Boolean            @default(false) @map("has_formal_assessment")
  currentChallenges   String?            @map("current_challenges")
  // Same free-text-tag shape as Track.interestTags, so results can lean on
  // shared vocabulary where relevant (e.g. a student interested in "art" or
  // "sports" gets that reflected in next-step suggestions too).
  interests           Json?
  notes               String?
  isActive            Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@map("student_support_assessments")
}

// ---- My Pathway: Talents & Strengths ----
// A single evolving self-report profile per student (not history-versioned
// like StudentPathwaySelection/StudentSupportAssessment) — a student's list
// of talents naturally gets edited in place rather than needing a full
// audit trail, so this is a plain upsert-by-studentId record.
model StudentTalentProfile {
  id        Int    @id @default(autoincrement())
  schoolId  Int    @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId Int    @unique @map("student_id")
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  talents    String[] @default([])
  strengths  String[] @default([])
  interests  String[] @default([])
  reflection String?
  // Free text: how the student (or a teacher/mentor) plans to grow this
  // talent — shown back to them and to staff as a nurturing prompt.
  growthPlan String?  @map("growth_plan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("student_talent_profiles")
}

// ---- My Pathway: Mentorship ----
// Mentors are existing TEACHER-role users who opt in to the student-facing
// directory — no new user type, per the explicit product decision to reuse
// existing teacher accounts rather than build a separate mentor directory.
model MentorProfile {
  id        Int    @id @default(autoincrement())
  teacherId Int    @unique @map("teacher_id")
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  Int    @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  bio            String?
  expertiseAreas String[] @default([]) @map("expertise_areas")
  isAvailable    Boolean  @default(true) @map("is_available")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests MentorshipRequest[]

  @@index([schoolId])
  @@map("mentor_profiles")
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

// A student's request to connect with a mentor. One row per student-mentor
// thread — a student can have several over time (different mentors/topics);
// this is an ongoing relationship rather than a point-in-time choice, so
// unlike StudentPathwaySelection it isn't history-versioned via isActive.
model MentorshipRequest {
  id              Int           @id @default(autoincrement())
  schoolId        Int           @map("school_id")
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       Int           @map("student_id")
  student         User          @relation("MentorshipRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentorProfileId Int           @map("mentor_profile_id")
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  topic   String
  message String?
  status  MentorshipStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime? @map("responded_at")

  logEntries MentorshipLogEntry[]

  @@index([schoolId])
  @@index([studentId])
  @@index([mentorProfileId])
  @@map("mentorship_requests")
}

// A dated note on a mentorship thread — either side (student or the
// mentoring teacher) can add one once the request is ACCEPTED. This is the
// "mentorship log."
model MentorshipLogEntry {
  id        Int               @id @default(autoincrement())
  requestId Int               @map("request_id")
  request   MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  Int               @map("author_id")
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  note      String

  createdAt DateTime @default(now())

  @@index([requestId])
  @@map("mentorship_log_entries")
}

// ---- News/Messages ----
// Direct messaging between a school's students and teachers, replacing the
// old "My Activity" tab. Any STUDENT can message any TEACHER at their school
// and vice versa (mirrors MentorProfile's "any teacher" directory scope, just
// two-way) — enforced in MessagesService.assertCanMessage, not here.
// SCHOOL_ADMIN (and PLATFORM_ADMIN via schoolId) get read-only oversight of
// every conversation at the school, the same transparency precedent as
// Parent Corner. One row per message, not per thread — a "conversation" is
// simply every Message between one student and one teacher, derived at query
// time (see MessagesService.findContacts / findAdminConversations) rather
// than a separate thread table, since there's exactly one thread per
// student-teacher pair.
model Message {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  senderId Int  @map("sender_id")
  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId Int  @map("recipient_id")
  recipient   User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  body   String
  // Set the first time the recipient opens the thread containing this
  // message — see MessagesService.findThread. Null = unread.
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
  @@map("messages")
}

// ---- Independent Students (enrolled without a school) ----
// A student enrolled directly by PLATFORM_ADMIN, not through a paying
// school — they belong to a single system-wide "Independent Students"
// School row (lazily created by IndependentStudentsService, code
// "INDEPENDENT") purely so the rest of the app's schoolId-scoped machinery
// (assignments, labs, TenantGuard, etc.) keeps working unmodified. Unlike
// school billing (Subscription/Invoice/PaymentTransaction, all scoped per
// SCHOOL and priced by enrolled-student-count), each independent student
// pays for their OWN access individually via M-Pesa Till Number, so this is
// a separate, per-STUDENT record rather than a reuse of those school-billing
// tables. One row per payment a platform admin manually records after
// verifying the M-Pesa confirmation code; recording one extends the
// student's User.subscriptionExpiresAt and reactivates them.
model IndependentStudentInvoice {
  id        Int  @id @default(autoincrement())
  studentId Int  @map("student_id")
  student   User @relation("IndependentInvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  invoiceNumber String               @unique @map("invoice_number")
  // Snapshot of the student's name at the time of this invoice, so the
  // record stays meaningful even if the account is later renamed.
  studentName   String               @map("student_name")
  amountKES     Int                  @map("amount_kes")
  interval      SubscriptionInterval @default(MONTHLY)
  periodStart   DateTime             @map("period_start")
  periodEnd     DateTime             @map("period_end")

  // The M-Pesa confirmation code from the Till Number payment, entered by
  // the platform admin after verifying it — this is the actual proof of
  // payment, since there's no live payment-gateway integration here.
  mpesaCode  String  @map("mpesa_code")
  payerPhone String? @map("payer_phone")

  recordedById Int?  @map("recorded_by_id")
  recordedBy   User? @relation("IndependentInvoiceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("independent_student_invoices")
}

model IndependentPaymentClaim {
  id        Int  @id @default(autoincrement())
  studentId Int  @map("student_id")
  student   User @relation("IndependentPaymentClaimStudent", fields: [studentId], references: [id], onDelete: Cascade)

  amountKES  Int                           @map("amount_kes")
  interval   SubscriptionInterval          @default(MONTHLY)
  mpesaCode  String                        @unique @map("mpesa_code")
  payerPhone String?                       @map("payer_phone")
  status     IndependentPaymentClaimStatus @default(AWAITING_VERIFICATION)

  reviewedById    Int?      @map("reviewed_by_id")
  reviewedBy      User?     @relation("IndependentPaymentClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("independent_payment_claims")
}

// Hosted Paystack payments for learners who subscribe independently. This is
// deliberately separate from school PaymentTransaction records: a school is
// onboarded offline, while an individual renews only their own access.
model IndependentPaystackPayment {
  id        Int  @id @default(autoincrement())
  studentId Int  @map("student_id")
  student   User @relation("IndependentPaystackPaymentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  reference String               @unique
  amountKES Int                  @map("amount_kes")
  interval  SubscriptionInterval @default(MONTHLY)
  status    PaymentStatus        @default(PENDING)
  email     String
  paidAt    DateTime?            @map("paid_at")
  rawPayload Json?
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([studentId, status])
  @@map("independent_paystack_payments")
}

// ============================================================================
// Centralized Question Bank
// ----------------------------------------------------------------------------
// Replaces per-teacher AI generation for the shared-content use case: a
// PLATFORM_ADMIN uploads source material, generates a batch of questions
// with OpenAI, reviews/approves them, and the approved questions become a
// single global bank every activated school's teachers can browse (read
// only) to assemble their own Assignment, and that can also be published
// directly as an Assignment for independent students. This is intentionally
// a separate pipeline from AiContentArtifact/AiGenerationJob (backend/src/
// ai-content), which remains per-school and per-teacher — see
// backend/src/question-bank/README.md for why the two aren't merged.
// ============================================================================

model QuestionBank {
  id Int @id @default(autoincrement())

  source   QuestionBankSource @default(PLATFORM)
  isGlobal Boolean            @default(true) @map("is_global")

  // Set only for a possible future SCHOOL-sourced row. Every row created by
  // this change is PLATFORM/isGlobal=true with schoolId null.
  schoolId Int?    @map("school_id")
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdById Int  @map("created_by_id")
  createdBy   User @relation("QuestionBankCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  sourceDocumentId Int?                        @map("source_document_id")
  sourceDocument   QuestionBankSourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  subject String
  grade   String
  topic   String

  questionText  String       @map("question_text")
  contentHtml   String?      @map("content_html")
  questionType  QuestionType @default(ESSAY) @map("question_type")
  // Same shapes as Question.options (backend/prisma/schema.prisma:Question).
  options       Json?
  // Same shape as Question.config — private grading rules, never sent to
  // students. Copied verbatim onto the real Question row at selection time.
  config        Json?
  correctAnswer String?      @map("correct_answer")
  explanation   String?
  points        Int          @default(10)
  hint          String?
  difficulty    String?
  // AI-classified Bloom's Taxonomy level (e.g. "REMEMBER", "UNDERSTAND",
  // "APPLY", "ANALYZE", "EVALUATE", "CREATE") — metadata for review/filtering,
  // not a QuestionType. Null for rows generated before this existed.
  bloomLevel    String?      @map("bloom_level")
  // Set by an admin uploading an image in the review queue (via the
  // existing generic /api/v1/uploads/single endpoint — this column just
  // stores the URL it returns). A "suggested diagram" from generation only
  // sets diagramAlt as a caption for the admin to act on, never diagramUrl.
  diagramUrl    String?      @map("diagram_url")
  diagramAlt    String?      @map("diagram_alt")

  status QuestionBankStatus @default(GENERATED)

  // Groups every question produced by one upload+generate call so the admin
  // review screen can approve/reject a batch together. Not a foreign key —
  // just a correlation id (crypto.randomUUID()).
  generationBatchId String? @map("generation_batch_id")
  sourceFileName    String? @map("source_file_name")

  reviewedById Int?      @map("reviewed_by_id")
  reviewedBy   User?     @relation("QuestionBankReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at")

  // Set when this exact bank question was copied onto the standing
  // "independent students" Assignment via the publish-to-independent-
  // students action (see QuestionBankService.publishToIndependentStudents).
  // Not set when a school teacher selects the question — that creates the
  // teacher's own Assignment/Question rows and does not modify this row.
  publishedAssignmentId Int?        @map("published_assignment_id")
  publishedAssignment   Assignment? @relation("QuestionBankPublishedAssignment", fields: [publishedAssignmentId], references: [id], onDelete: SetNull)
  publishedAt           DateTime?   @map("published_at")

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  usages    QuestionBankUsage[]
  learningCoachResponses LearningCoachResponse[]

  @@index([isGlobal, status, subject, grade])
  @@index([schoolId, status])
  @@index([generationBatchId])
  @@index([sourceDocumentId])
  @@map("question_bank")
}

// Platform-owned curriculum sources are retained as searchable chunks so a
// new question batch can be grounded in the relevant topic without sending
// an entire textbook to the AI provider on every request.
model QuestionBankSourceDocument {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  grade       String
  fileName    String?  @map("file_name")
  sourceType  String   @map("source_type")
  contentHash String   @map("content_hash")
  createdById Int      @map("created_by_id")
  createdBy   User     @relation("QuestionBankSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  chunks    QuestionBankSourceChunk[]
  questions QuestionBank[]

  @@unique([contentHash, subject, grade])
  @@index([subject, grade, createdAt])
  @@map("question_bank_source_documents")
}

model QuestionBankSourceChunk {
  id         Int                         @id @default(autoincrement())
  documentId Int                         @map("document_id")
  document   QuestionBankSourceDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  content    String                      @db.Text
  searchText String                      @map("search_text") @db.Text
  createdAt  DateTime                    @default(now()) @map("created_at")
  embedding  QuestionBankChunkEmbedding?

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("question_bank_source_chunks")
}

// Embeddings are deliberately stored beside source chunks instead of on the
// curriculum content itself. This keeps the source immutable and lets the
// vector provider/model be replaced without changing question-bank records.
model QuestionBankChunkEmbedding {
  id         Int                     @id @default(autoincrement())
  chunkId    Int                     @unique @map("chunk_id")
  chunk      QuestionBankSourceChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  provider   String
  model      String
  dimensions Int
  vector     Json
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  @@index([model])
  @@map("question_bank_chunk_embeddings")
}

// Records which curated questions each school has already used. Rotation
// selects the least-used questions first and never exposes this ledger to
// students.
model QuestionBankUsage {
  id             Int          @id @default(autoincrement())
  schoolId       Int          @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  questionBankId Int          @map("question_bank_id")
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  assignmentId   Int          @map("assignment_id")
  assignment     Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  selectedById   Int          @map("selected_by_id")
  selectedBy     User         @relation("QuestionBankUsageSelectedBy", fields: [selectedById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([assignmentId, questionBankId])
  @@index([schoolId, questionBankId, createdAt])
  @@map("question_bank_usages")
}

// One row per school that a PLATFORM_ADMIN has activated for Question Bank
// access. Deliberately a separate join-style table rather than a column on
// School, matching the existing AiFeatureConfig pattern, so the core School
// model doesn't need a migration for this.
model SchoolQuestionBankAccess {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  activatedById Int?     @map("activated_by_id")
  activatedBy   User?    @relation("SchoolQuestionBankActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  activatedAt   DateTime @default(now()) @map("activated_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("school_question_bank_access")
}

// Optional per-assignment delivery policy for question-bank assessments.
// The Assignment still owns ordinary Question rows; this configuration only
// controls how many of those approved pool questions each learner receives.
model AssignmentDeliveryConfig {
  id           Int        @id @default(autoincrement())
  schoolId     Int        @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId Int        @unique @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  questionCount  Int     @map("question_count")
  poolSize       Int     @map("pool_size")
  shuffleOptions Boolean @default(true) @map("shuffle_options")
  enabled        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schoolId, enabled])
  @@map("assignment_delivery_configs")
}

// Immutable learner-specific selection generated on first open. Question IDs
// refer to the Assignment's existing Question rows, so grading, feedback and
// reports continue through the established submission pipeline.
model StudentAssignmentVariant {
  id           Int        @id @default(autoincrement())
  schoolId     Int        @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId Int        @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    Int        @map("student_id")
  student      User       @relation("StudentAssignmentVariantStudent", fields: [studentId], references: [id], onDelete: Cascade)

  questionIds  Int[] @map("question_ids")
  optionOrders Json? @map("option_orders")
  totalPoints  Int   @map("total_points")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([assignmentId, studentId])
  @@index([schoolId, studentId, createdAt])
  @@map("student_assignment_variants")
}

// Private generated practice papers. Answer keys stay server-side until submission.
model KjseaMockAttempt {
  subject String @default("Mathematics")
  source String @default("GENERATED")
  coverage Json @default("{}")
  id String @id @default(cuid())
  schoolId Int @map("school_id")
  studentId Int @map("student_id")
  seed Int
  version String @default("kjsea-maths-v1")
  status String @default("DRAFT")
  questions Json
  answers Json @default("{}")
  timeLimitMinutes Int? @map("time_limit_minutes")
  score Int?
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  student User @relation(fields:[studentId],references:[id],onDelete:Cascade)
  @@index([schoolId,studentId,createdAt])
  @@map("kjsea_mock_attempts")
}
