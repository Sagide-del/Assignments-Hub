# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assignments_hub?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins in production, e.g.
# CORS_ORIGIN="https://app.assignmentshub.co.ke"
# Leave unset in development to allow all origins.
CORS_ORIGIN=

# Seed data (used by prisma/seed.ts)
SEED_PLATFORM_ADMIN_EMAIL="admin@assignmentshub.co.ke"
SEED_PLATFORM_ADMIN_PASSWORD="ChangeMe123!"

# IntaSend (payments) — get these from your IntaSend dashboard
# (Settings > API Keys). Without these, subscription checkout and the
# webhook that activates a school's subscription will not work.
#
# IMPORTANT: keys are environment-locked. Test keys start with
# "ISPubKey_test_" / "ISSecretKey_test_" and only work against the sandbox
# (INTASEND_TEST_MODE="true"). Live keys start with "ISPubKey_live_" /
# "ISSecretKey_live_" and only work with INTASEND_TEST_MODE="false".
# Mixing a test key with live mode (or vice versa) is exactly what causes
# IntaSend's `authentication_failed` / "Session expired" error — double
# check the key prefix matches INTASEND_TEST_MODE before assuming it's a
# code bug.
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
# Must match the "challenge" string you set when registering the webhook
# URL on the IntaSend dashboard (Settings > Webhooks) — IntaSend echoes it
# back inside every webhook JSON body as `challenge`, it is NOT a header
# or an HMAC signing secret. Point the webhook at:
# POST {your-api-url}/api/v1/payment/webhook
INTASEND_WEBHOOK_SECRET=""
# "true" while testing against IntaSend's sandbox, "false" once you're
# taking real payments. Must match the key prefix above (test vs live).
INTASEND_TEST_MODE="true"

# Optional: used as `host` / `redirect_url` on IntaSend checkout requests.
# APP_URL is your site's own domain (shown to the customer during checkout).
# PAYMENT_REDIRECT_URL is where IntaSend sends the customer back after a
# successful payment, e.g. "https://app.assignmentshub.co.ke/school-admin-dashboard/index.html".
APP_URL=""
PAYMENT_REDIRECT_URL=""

# Individual student subscriptions. All values are served by the backend;
# the public registration UI never embeds Till details or prices.
INDEPENDENT_MPESA_TILL_NUMBER=""
INDEPENDENT_MPESA_STORE_NUMBER=""
INDEPENDENT_MONTHLY_PRICE_KES=""
INDEPENDENT_ANNUAL_PRICE_KES=""
INDEPENDENT_MPESA_INSTRUCTIONS="Pay via M-Pesa Buy Goods, then submit the confirmation code for verification."

# AWS file storage. New assignment images, student attachments, school logos,
# and mnemonic card PDFs are uploaded to S3. In production, prefer an IAM role
# instead of long-lived access keys and put a private bucket behind CloudFront.
AWS_REGION="af-south-1"
AWS_S3_BUCKET=""
# Public CloudFront distribution URL, without a trailing slash. If omitted,
# the API returns the standard S3 object URL, which requires public read access.
AWS_CDN_BASE_URL=""
# Optional for local development. AWS deployments should use an IAM role.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# AI content pipeline. All switches default to off in code and should remain
# false until the additive AI migration has been deployed and a school-level
# AiFeatureConfig has been enabled by a platform admin.
AI_FEATURES_ENABLED="false"
AI_ASSIGNMENT_DRAFTS_ENABLED="false"
AI_QUESTION_SETS_ENABLED="false"
AI_FEEDBACK_DRAFTS_ENABLED="false"
AI_GRADING_SUGGESTIONS_ENABLED="false"
AI_LEARNING_RECOMMENDATIONS_ENABLED="false"

# AI provider. OpenAI is the sole provider (DeepSeek/Claude were removed —
# see AiProviderRouterService/OpenaiService). Never expose this server-side
# key to the frontend.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"

# BullMQ background processing. Without REDIS_URL the backend uses a
# non-durable asynchronous fallback intended only for local development.
REDIS_URL=""
AI_WORKERS_ENABLED="true"
AI_WORKER_CONCURRENCY="2"
